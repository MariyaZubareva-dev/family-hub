# Copy to .env.production on the server. Never commit the populated file.
APP_KEY=base64:GENERATE_A_UNIQUE_KEY
TELEGRAM_BOT_TOKEN=SET_FROM_BOTFATHER
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Preserve the current production DB credentials for the first deployment.
# Rotate the DB password only as a separate, tested operation.
DB_DATABASE=family_hub
DB_USERNAME=family_hub
DB_PASSWORD=SET_CURRENT_PRODUCTION_DB_PASSWORD
POSTGRES_VOLUME_NAME=SET_EXACT_EXISTING_DOCKER_VOLUME_NAME
REDIS_VOLUME_NAME=SET_EXACT_EXISTING_DOCKER_REDIS_VOLUME_NAME

APP_TIMEZONE=Europe/Moscow
APP_LOCALE=ru
APP_FALLBACK_LOCALE=ru
LOG_CHANNEL=stderr
LOG_LEVEL=warning
REDIS_CLIENT=predis
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=family_hub_
FILESYSTEM_DISK=local
